<?xml version="1.0"?>
<model>
  <name>simple_drone</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Kinematic quadrotor stand-in for the pursuer, case-study visualization
    only — no rotor/motor aerodynamics. Driven by Gazebo's VelocityControl
    plugin (accepts a geometry_msgs/Twist on /model/simple_drone/cmd_vel via
    the ros_gz bridge), so the pursuit_controller node can fly it directly
    by commanded velocity rather than needing a full flight-stack (PX4/
    ArduPilot) SITL setup.
  </description>
</model>
