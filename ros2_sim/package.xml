<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_sim</name>
  <version>0.1.0</version>
  <description>
    Case-study Gazebo/RViz2 visualization: a ground robot (evader) and a
    drone (pursuer) tracking each other in a scaled, dilated real-world
    replica of poly9 from the Python KER pursuit-evasion simulation.
  </description>
  <maintainer email="smandal@iastate.edu">Shashwata Mandal</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
