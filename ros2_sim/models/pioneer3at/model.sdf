        </link>
        <link name="left_rear_wheel">
            <pose>-0.125 0.201 -0.06 1.5707 0 0</pose>
            <inertial>
                <mass>1.5</mass>
                <inertia>
                    <ixx>0.005240625</ixx>
                    <iyy>0.005240625</iyy>
                    <izz>0.009075</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius>0.110</radius>
