Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Plane Cell Count: 30
      Color: 160; 160; 164
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Evader (Pioneer 3AT) [actual]
      Topic:
        Value: /evader/odom
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Keep: 300
      Shape:
        Value: Arrow
      Color: 255; 90; 90
      Enabled: true
    - Class: rviz_default_plugins/Odometry
      Name: Pursuer (X4 UAV) [actual]
      Topic:
        Value: /pursuer/odom
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Keep: 300
      Shape:
        Value: Arrow
      Color: 90; 160; 255
      Enabled: true
    - Class: rviz_default_plugins/Marker
      Name: Algorithm targets
      Topic:
        Value: /viz/algorithm_targets
      Enabled: true
      Description: >-
        Orange sphere = pursuer's current hover target (evader's actual
        position at cruise altitude). Cyan sphere = evader wander
        placeholder's current target heading, projected ahead. Both are
        exactly what each controller is steering toward this step, not a
        recorded trail.
  Global Options:
    Background Color: 45; 45; 48
    Fixed Frame: world
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 30
      Pitch: 0.7
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 900
  Width: 1400
