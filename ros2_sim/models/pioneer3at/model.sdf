        <pose>0.2 0 0.13 0 0 0</pose>
      </include>
      <joint name="hokuyo_joint" type="revolute">
        <child>hokuyo::link</child>
        <parent>chassis</parent>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <upper>0</upper>
            <lower>0</lower>
          </limit>
        </axis>
      </joint>
    -->
    </model>
</sdf>
