        </link>
        <joint type="revolute" name="right_front">
            <pose>0 0 0 0 0 0</pose>
            <child>right_front_wheel</child>
            <parent>chassis</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <use_parent_model_frame>true</use_parent_model_frame>
            </axis>
        </joint>
        <joint type="revolute" name="right_rear">
            <pose>0 0 0 0 0 0</pose>
            <child>right_rear_wheel</child>
            <parent>chassis</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <use_parent_model_frame>true</use_parent_model_frame>
            </axis>
        </joint>
        <joint type="revolute" name="left_front">
            <pose>0 0 0 0 0 0</pose>
            <child>left_front_wheel</child>
            <parent>chassis</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <use_parent_model_frame>true</use_parent_model_frame>
            </axis>
        </joint>
        <joint type="revolute" name="left_rear">
            <pose>0 0 0 0 0 0</pose>
            <child>left_rear_wheel</child>
            <parent>chassis</parent>
            <axis>
                <xyz>0 1 0</xyz>
                <use_parent_model_frame>true</use_parent_model_frame>
            </axis>
        </joint>
        <!-- Original SkidSteerDrivePlugin (Gazebo Classic) removed — see
             model.config. Deliberately kinematic (no wheel torque/
             friction/momentum): this is the evader, and the case study
             only evaluates the PURSUER's tracking performance, so giving
             the evader realistic wheel dynamics only adds noise (and an
             extra place for it to get stuck) with no benefit. Uses
             VelocityControl on the chassis body directly — same plugin
             pattern the drone used before it got real rotor dynamics.
             Default command topic is /model/<name>/cmd_vel (confirmed from
             Fortress's own shipped worlds/velocity_control.sdf header
             comment), matching what's already bridged in sim.launch.py, so
             no launch changes needed. Frame convention confirmed
             empirically (not assumed): ran that same shipped demo — a
             vehicle spinning while commanded constant linear.x traced a
             curving/spiraling path, which only happens if linear.x is
             interpreted in the model's BODY frame — so evader_wanderer.py's
             existing forward-speed + turn-rate control (written for
             DiffDrive, also body-frame) needs no logic changes here. -->
        <plugin filename="ignition-gazebo-velocity-control-system"
                name="gz::sim::systems::VelocityControl">
        </plugin>

        <!-- odom_frame explicitly set to "world" (matching RViz's Fixed
             Frame) rather than the default "pioneer3at/odom" — this repo
             doesn't bridge /tf, so without this the Odometry display has no
             way to resolve the message's frame_id into the Fixed Frame and
             silently renders nothing. Confirmed against Fortress's own
             worlds/vehicle.sdf, which sets these same two params. -->
        <plugin filename="ignition-gazebo-odometry-publisher-system"
                name="ignition::gazebo::systems::OdometryPublisher">
          <dimensions>3</dimensions>
          <odom_frame>world</odom_frame>
          <robot_base_frame>simple_ground_robot</robot_base_frame>
        </plugin>

        <plugin filename="ignition-gazebo-pose-publisher-system"
                name="gz::sim::systems::PosePublisher">
          <publish_link_pose>true</publish_link_pose>
          <publish_collision_pose>false</publish_collision_pose>
          <publish_visual_pose>false</publish_visual_pose>
          <publish_nested_model_pose>false</publish_nested_model_pose>
        </plugin>
        <!--    
