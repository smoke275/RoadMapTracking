<?xml version="1.0" ?>
<sdf version="1.5">
    <model name="pioneer3at">
        <pose>0 0 0.180 0 0 0</pose>
        <static>false</static>
        <link name="chassis">
            <inertial>
                <mass>14.0</mass>
                <inertia>
                    <ixx>0.147116667</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>0.334951167</iyy>
                    <iyz>0.0</iyz>
                    <izz>0.3978345</izz>
                </inertia>
            </inertial>
            <collision name="collision">
                <geometry>
                    <box>
                        <size>0.501 0.300 0.19</size>
                    </box>
                </geometry>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/chassis.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <!-- Wall-bump detector: requires the world-level Contact system
                 (added to generate_world.py's output). Publishes on
                 /world/<world>/model/pioneer3at/link/chassis/sensor/chassis_contact/contact
                 whenever this link's collision touches another collision,
                 confirmed against Fortress's own shipped
                 worlds/contact_sensor.sdf syntax and topic convention. -->
            <sensor name="chassis_contact" type="contact">
                <contact>
                    <collision>collision</collision>
                </contact>
                <update_rate>30</update_rate>
            </sensor>
        </link>
        <link name="right_front_wheel">
            <pose>0.125 -0.201 -0.06 1.5707 0 0</pose>
            <inertial>
                <mass>1.5</mass>
                <inertia>
                    <ixx>0.005240625</ixx>
                    <iyy>0.005240625</iyy>
                    <izz>0.009075</izz>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyz>0</iyz>
                </inertia>
            </inertial>
            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius>0.110</radius>
                        <length>0.075</length>
                    </cylinder>
                </geometry>
                <surface>
                    <friction>
                        <ode>
                            <mu>1</mu>
                            <mu2>1</mu2>
                            <slip1>0.5</slip1>
                            <slip2>0</slip2>
                        </ode>
                    </friction>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/wheel.dae</uri>
                    </mesh>
                </geometry>
            </visual>
        </link>
