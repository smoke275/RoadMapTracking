<?xml version='1.0'?>
<sdf version='1.9'>
  <model name='simple_ground_robot'>
    <pose>0 0 0.05 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name='chassis'>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.03</ixx><iyy>0.05</iyy><izz>0.06</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name='chassis_collision'>
        <geometry><box><size>0.30 0.25 0.10</size></box></geometry>
      </collision>
      <visual name='chassis_visual'>
        <geometry><box><size>0.30 0.25 0.10</size></box></geometry>
        <material><ambient>0.15 0.35 0.85 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material>
      </visual>
      <!-- four cosmetic wheel visuals; VelocityControl drives the whole
           body directly, no wheel-joint kinematics needed for this
           case-study visualization -->
      <visual name='wheel_fl'>
        <pose>0.10 0.14 -0.03 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
      <visual name='wheel_fr'>
        <pose>0.10 -0.14 -0.03 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
      <visual name='wheel_bl'>
        <pose>-0.10 0.14 -0.03 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
      <visual name='wheel_br'>
        <pose>-0.10 -0.14 -0.03 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
    </link>

    <!-- Same verified plugin block as simple_drone/model.sdf — see that
         file's comment for how filenames/class-names were confirmed
         against the actual installed Gazebo (Ignition Fortress). -->
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
    </plugin>

    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>

    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
    </plugin>
  </model>
</sdf>
