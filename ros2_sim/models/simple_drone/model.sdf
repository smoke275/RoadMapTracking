<?xml version='1.0'?>
<sdf version='1.9'>
  <model name='simple_drone'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>

    <link name='body'>
      <inertial>
        <mass>1.2</mass>
        <inertia>
          <ixx>0.02</ixx><iyy>0.02</iyy><izz>0.035</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name='body_collision'>
        <geometry><box><size>0.35 0.35 0.10</size></box></geometry>
      </collision>
      <visual name='body_visual'>
        <geometry><box><size>0.35 0.35 0.10</size></box></geometry>
        <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
      </visual>
      <!-- four arm+rotor visuals, purely cosmetic so it reads as a quadrotor -->
      <visual name='arm_fl'>
        <pose>0.28 0.28 0.02 0 0 0.7854</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient></material>
      </visual>
      <visual name='arm_fr'>
        <pose>0.28 -0.28 0.02 0 0 -0.7854</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient></material>
      </visual>
      <visual name='arm_bl'>
        <pose>-0.28 0.28 0.02 0 0 -0.7854</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient></material>
      </visual>
      <visual name='arm_br'>
        <pose>-0.28 -0.28 0.02 0 0 0.7854</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.15 0.15 0.15 1</ambient></material>
      </visual>
    </link>

    <!-- Kinematic velocity control: subscribes to a Twist on
         /model/simple_drone/cmd_vel (the default topic for this plugin —
         confirmed via the installed velocity_control.sdf example, which
         omits an explicit <topic> override) and directly drives the
         model's linear/angular velocity. No rotor aerodynamics —
         appropriate for a case-study visualization, not a flight-controller
         validation.

         Plugin filenames/class-names below were verified against the
         actual installed Gazebo (Ignition Fortress / Gazebo 6, shipped in
         osrf/ros:humble-desktop-full) by inspecting its own shipped example
         worlds, not assumed from generic Gazebo documentation — this
         version shipped mid-rename from "Ignition" to "Gazebo", so the
         three plugins below are inconsistent with each other on purpose:
         OdometryPublisher is only registered under the old
         ignition::gazebo::systems:: namespace in this release, while
         VelocityControl and PosePublisher are under the new gz::sim::systems::
         one. -->
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
    </plugin>

    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>

    <plugin filename="ignition-gazebo-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
    </plugin>
  </model>
</sdf>
